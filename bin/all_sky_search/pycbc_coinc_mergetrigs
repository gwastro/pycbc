#!/usr/bin/env python

"""This program adds single detector hdf trigger files together."""

import argparse
import logging

import h5py
import numpy

from pycbc import add_common_pycbc_options, init_logging
from pycbc.io import HFile

logger = logging.getLogger(__name__)


def changes(arr):
    l = numpy.where(arr[:-1] != arr[1:])[0]
    l = numpy.concatenate(([0], l + 1, [len(arr)]))
    return numpy.unique(l)


def collect(key, files):
    data = []
    for fname in files:
        with HFile(fname, "r") as fin:
            if key in fin:
                data += [fin[key][:]]
    return numpy.concatenate(data)


def region(f, key, boundaries, ids):
    dset = f[key]
    refs = []
    for j in range(len(boundaries) - 1):
        l, r = boundaries[ids[j]], boundaries[ids[j] + 1]
        refs.append(dset.regionref[l:r])
    f.create_dataset(
        key + "_template", data=refs, dtype=h5py.special_dtype(ref=h5py.RegionReference)
    )


parser = argparse.ArgumentParser()
add_common_pycbc_options(parser)
parser.add_argument("--trigger-files", nargs="+")
parser.add_argument("--output-file", required=True)
parser.add_argument("--bank-file", required=True)
parser.add_argument(
    "--ifo",
    type=str,
    default=None,
    help="Detector IFO to merge (if not specified, all IFOs in input files are merged)",
)
parser.add_argument(
    "--compression-level",
    type=int,
    default=6,
    help="Set HDF compression level in the output file (default 6)",
)
args = parser.parse_args()

init_logging(args.verbose)


def _open_hfile(fname):
    try:
        return HFile(fname, "r")
    except OSError:
        logger.exception("Cannot open %s", fname)
        raise


f = HFile(args.output_file, "w")

# For fast lookup we need the templates in hash order
with HFile(args.bank_file, "r") as bank_f:
    hashes = bank_f["template_hash"][:]
bank_tids = hashes.argsort()
unsort = bank_tids.argsort()
hashes = hashes[bank_tids]

if args.ifo is not None:
    ifos = [args.ifo]
else:
    ifos = []
    for fname in args.trigger_files:
        with _open_hfile(fname) as f2:
            for k in f2:
                if k not in ifos:
                    ifos.append(k)

for ifo in ifos:
    logger.info("Processing IFO: %s", ifo)
    logger.info("getting the list of columns from a representative file")
    trigger_columns = []
    for fname in args.trigger_files:
        with _open_hfile(fname) as f2:
            if ifo in f2 and "template_hash" in f2[ifo]:
                trigger_columns = [
                    col
                    for col in f2[ifo]
                    if col not in ("search", "template_hash", "gating")
                ]
                break

    for col in trigger_columns:
        logger.info("trigger column: %s", col)

    logger.info("reading the metadata from the files")

    tpc = numpy.array([], dtype=numpy.float64)
    frpc = numpy.array([], dtype=numpy.float64)
    stf = numpy.array([], dtype=numpy.float64)
    rtime = numpy.array([], dtype=numpy.float64)
    starts = numpy.array([], dtype=numpy.float64)
    ends = numpy.array([], dtype=numpy.float64)

    gating = {}
    for filename in args.trigger_files:
        with _open_hfile(filename) as data:
            if ifo not in data:
                continue
            ifo_data = data[ifo]

            starts = numpy.append(starts, ifo_data["search/start_time"][:])
            ends = numpy.append(ends, ifo_data["search/end_time"][:])

            if "templates_per_core" in ifo_data["search"]:
                tpc = numpy.append(tpc, ifo_data["search/templates_per_core"][:])
            if "filter_rate_per_core" in ifo_data["search"]:
                frpc = numpy.append(frpc, ifo_data["search/filter_rate_per_core"][:])
            if "setup_time_fraction" in ifo_data["search"]:
                stf = numpy.append(stf, ifo_data["search/setup_time_fraction"][:])
            if "run_time" in ifo_data["search"]:
                rtime = numpy.append(rtime, ifo_data["search/run_time"][:])

            if "gating" in ifo_data:
                gating_keys = []
                ifo_data["gating"].visit(gating_keys.append)
                for gk in gating_keys:
                    gk_data = ifo_data["gating/" + gk]
                    if isinstance(gk_data, h5py.Dataset):
                        if gk not in gating:
                            gating[gk] = numpy.array([], dtype=numpy.float64)
                        gating[gk] = numpy.append(gating[gk], gk_data[:])

    # store de-duplicated segments sorted by start time
    starts, uindex = numpy.unique(starts, return_index=True)
    ends = ends[uindex]
    sort = starts.argsort()

    f[f"{ifo}/search/start_time"] = starts[sort]
    f[f"{ifo}/search/end_time"] = ends[sort]

    if len(tpc) > 0:
        f[f"{ifo}/search/templates_per_core"] = tpc
    if len(frpc) > 0:
        f[f"{ifo}/search/filter_rate_per_core"] = frpc
    if len(stf) > 0:
        f[f"{ifo}/search/setup_time_fraction"] = stf
    if len(rtime) > 0:
        f[f"{ifo}/search/run_time"] = rtime

    for gk, gv in gating.items():
        f[ifo + "/gating/" + gk] = gv

    logger.info("set up sorting of triggers and template ids")
    trigger_hashes = collect(f"{ifo}/template_hash", args.trigger_files)
    trigger_sort = trigger_hashes.argsort()
    trigger_hashes = trigger_hashes[trigger_sort]
    template_boundaries = changes(trigger_hashes)

    template_ids = bank_tids[
        numpy.searchsorted(hashes, trigger_hashes[template_boundaries[:-1]])
    ]

    full_boundaries = numpy.searchsorted(trigger_hashes, hashes)
    full_boundaries = numpy.concatenate([full_boundaries, [len(trigger_hashes)]])
    # get the full boundaries in hash order
    del trigger_hashes

    idlen = template_boundaries[1:] - template_boundaries[:-1]
    f.create_dataset(
        f"{ifo}/template_id",
        data=numpy.repeat(template_ids, idlen),
        compression="gzip",
        shuffle=True,
        compression_opts=args.compression_level,
    )
    f[f"{ifo}/template_boundaries"] = full_boundaries[unsort]

    logger.info("reading the trigger columns from the input files")
    for col in trigger_columns:
        key = f"{ifo}/{col}"
        logger.info("reading %s", col)
        data = collect(key, args.trigger_files)[trigger_sort]
        logger.info("writing %s to file", col)
        dset = f.create_dataset(
            key,
            data=data,
            compression="gzip",
            compression_opts=args.compression_level,
            shuffle=True,
        )
        del data
        region(f, key, full_boundaries, unsort)

f.close()
logger.info("done")
