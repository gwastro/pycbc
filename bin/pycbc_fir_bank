#!/usr/bin/env python
import argparse
import logging
import multiprocessing as mp
import sys
from collections import defaultdict

import numpy as np
import scipy.linalg
from tqdm import tqdm

import pycbc
import pycbc.psd
from pycbc.filter import match, sigma
from pycbc.types import TimeSeries
from pycbc.waveform.bank import FilterBank

# --- GLOBAL WORKER DATA (set by initializer) ---
g_coarse_waveforms = None
g_fine_bank = None
g_psd = None
g_args = None

def init_worker(coarse_waveforms, fine_bank, psd, args_namespace):
    """
    Initializer function for each worker process.
    Sets read-only global variables.
    """
    global g_coarse_waveforms, g_fine_bank, g_psd, g_args
    g_coarse_waveforms = coarse_waveforms
    g_fine_bank = fine_bank
    g_psd = psd
    g_args = args_namespace
    # Silence worker logging
    logging.getLogger('pycbc').setLevel(logging.CRITICAL + 1)

# --- 1. Filter Designer (Double Precision) ---
def design_optimal_real_filter(H_target_pos, valid_mask_pos, K_taps, weights_pos=None, reg_type='ridge', reg_val=1e-4,
                                peak_cap_factor=10.0, peak_bad_weight_fraction=1.0, peak_max_passes=3):
    """
    Designs a filter using regularized least squares.
    reg_type='ridge'      -> Minimizes energy (Standard)
    reg_type='derivative' -> Minimizes roughness (Smooth coefficients)

    Peak suppression (peak_cap_factor > 0): the fit above is only
    constrained inside valid_mask_pos (the analysis passband). Outside it,
    for templates poorly matched to their coarse reference, the achieved
    frequency response can develop an enormous, essentially unconstrained
    gain at a handful of bins -- harmless in exact arithmetic (that region
    gets multiplied by ~zero data content), but applying such a filter in
    single precision causes floating-point cancellation error large enough
    to produce wildly incorrect reconstructed SNR values. After the initial
    fit, any bin (evaluated across the FULL band, not just valid_mask_pos)
    whose magnitude exceeds peak_cap_factor times the filter's own median
    magnitude is nudged toward zero by adding extra rows to the same
    least-squares system -- weighted like a typical in-band fit row, not
    the (much larger) bin value itself, since matching that scale bleeds
    energy back into the passband -- and refitting, up to peak_max_passes
    times. Set peak_cap_factor to 0 or None to disable.
    """
    # 1. Setup Grid
    N_nyquist = len(H_target_pos)
    N_full = 2 * (N_nyquist - 1)
    f_grid_pos = np.arange(N_nyquist) / N_full

    # 2. Select Valid
    valid_indices = np.where(valid_mask_pos)[0]
    f_valid = f_grid_pos[valid_indices]
    b_complex = H_target_pos[valid_indices]

    # 3. Design Matrix A
    if K_taps % 2 == 1:
        k_idx = np.arange(-(K_taps-1)//2, (K_taps-1)//2 + 1)
    else:
        k_idx = np.arange(-K_taps//2 + 1, K_taps//2 + 1)

    A_complex = np.exp(-1j * 2 * np.pi * np.outer(f_valid, k_idx))

    # Weights
    if weights_pos is not None:
        w_valid = weights_pos[valid_indices]
        A_complex *= w_valid[:, None]
        b_complex *= w_valid
    else:
        w_valid = np.ones(len(valid_indices))

    # Real Stack
    A_real = np.vstack([A_complex.real, A_complex.imag])
    b_real = np.concatenate([b_complex.real, b_complex.imag])

    if reg_type == 'derivative':
        reg_matrix = np.zeros((K_taps - 1, K_taps))
        for i in range(K_taps - 1):
            reg_matrix[i, i] = 1
            reg_matrix[i, i+1] = -1
        reg_matrix *= np.sqrt(reg_val)
        target_reg = np.zeros(K_taps - 1)

    elif reg_type == 'composite':
        # 1. Ridge component (Size control)
        reg_ridge = np.eye(K_taps) * np.sqrt(reg_val * 0.5)

        # 2. Derivative component (Smoothness control)
        reg_deriv = np.zeros((K_taps - 1, K_taps))
        for i in range(K_taps - 1):
            reg_deriv[i, i] = 1
            reg_deriv[i, i+1] = -1
        reg_deriv *= np.sqrt(reg_val * 0.5)

        # Stack both penalties together
        reg_matrix = np.vstack([reg_ridge, reg_deriv])
        target_reg = np.zeros(K_taps + K_taps - 1)

    else: # Default 'ridge'
        reg_matrix = np.eye(K_taps) * np.sqrt(reg_val)
        target_reg = np.zeros(K_taps)

    A_final = np.vstack([A_real, reg_matrix])
    b_final = np.concatenate([b_real, target_reg])

    try:
        h_optimal, _, _, _ = scipy.linalg.lstsq(A_final, b_final, lapack_driver='gelss')
        #h_optimal, _, _, _ = np.linalg.lstsq(A_final, b_final, rcond=None)
    except:
        logging.info('Exception with numpy least squares, moving to scipy')
        h_optimal, _, _, _ = scipy.linalg.lstsq(A_final, b_final, lapack_driver='gelss')
        logging.info('Scipy suceeded')

    n_peak_passes = 0
    n_bins_capped = 0
    if peak_cap_factor:
        A_full = np.exp(-1j * 2 * np.pi * np.outer(f_grid_pos, k_idx))
        positive_w = w_valid[w_valid > 0]
        typical_w = np.median(positive_w) if len(positive_w) else 1.0
        constrained_bins = set()
        cap = None
        for _pass in range(peak_max_passes):
            achieved = A_full @ h_optimal
            mag = np.abs(achieved)
            if cap is None:
                cap = peak_cap_factor * np.median(mag)
            bad = np.where(mag > cap)[0]
            n_bins_capped = len(bad)
            if n_bins_capped == 0:
                break
            n_peak_passes += 1
            constrained_bins.update(bad.tolist())

            idxs = np.array(sorted(constrained_bins))
            f_bad = f_grid_pos[idxs]
            w_bad = peak_bad_weight_fraction * typical_w
            row = np.exp(-1j * 2 * np.pi * np.outer(f_bad, k_idx)) * w_bad
            extra_A = np.vstack([row.real, row.imag])
            extra_b = np.zeros(2 * len(idxs))

            A_aug = np.vstack([A_real, reg_matrix, extra_A])
            b_aug = np.concatenate([b_real, target_reg, extra_b])
            h_optimal, _, _, _ = scipy.linalg.lstsq(A_aug, b_aug, lapack_driver='gelss')

    return h_optimal, n_peak_passes, n_bins_capped

# --- 2. Verification (Double Precision) ---
def verify_filter_match(taps, h_ref, h_fine, psd, f_low):
    """Check how well a designed FIR filter reconstructs the fine template.

    Applies `taps` to the coarse reference `h_ref` the way the search engine
    will (same circular tap layout) and compares the result to `h_fine`.

    Returns
    -------
    m : float
        Match between the reconstructed template and h_fine.
    sigmas : (float, float, float)
        sigma of h_ref, of the reconstruction, and of h_fine -- for sanity
        checking that reconstruction hasn't drastically changed the
        template's overall amplitude.
    """
    N = (len(h_ref) - 1) * 2
    K = len(taps)
    h_fir_time = np.zeros(N, dtype=np.float64)

    if K % 2 == 1: k_start = -(K - 1) // 2
    else: k_start = -K // 2 + 1
    indices = (np.arange(k_start, k_start + K) + N) % N
    h_fir_time[indices] = taps

    delta_t = 1.0 / (N * h_ref.delta_f)
    ts = TimeSeries(h_fir_time, delta_t=delta_t)
    H_fir = ts.to_frequencyseries(delta_f=h_ref.delta_f)

    if len(H_fir) > len(h_ref): H_fir = H_fir[:len(h_ref)]
    elif len(H_fir) < len(h_ref): H_fir.resize(len(h_ref))

    h_rec = h_ref * H_fir

    s_rec = sigma(h_rec, psd=psd, low_frequency_cutoff=f_low)
    s_ref = sigma(h_ref, psd=psd, low_frequency_cutoff=f_low)
    s_fine = sigma(h_fine, psd=psd, low_frequency_cutoff=f_low)
    m, _ = match(h_fine, h_rec, psd=psd, low_frequency_cutoff=f_low)
    return m, (s_ref, s_rec, s_fine)

# --- 3. WORKER FUNCTION (Executes in parallel) ---
def process_template(i):
    """
    Worker function that runs the full design loop for a single template index 'i'.

    Peak suppression (see design_optimal_real_filter) can only ever hold a
    fit's achieved match the same or make it worse -- it adds constraints to
    the same least-squares system, never relaxes any. So checking it on a
    (coarse reference, tap count) attempt that hasn't reached --min-match
    without suppression is wasted work: that attempt is going to escalate to
    more taps regardless of what suppression does to it. Suppression is
    therefore only evaluated at the two points where its result actually
    changes what gets accepted: (1) a candidate that clears --min-match
    *before* suppression, to confirm it still clears it after (if not, this
    isn't actually good enough yet -- keep escalating instead of accepting
    it); (2) the single best (by unsuppressed match) candidate seen across
    the whole search, as the final safety pass on whatever gets delivered if
    nothing ever cleared --min-match at all.
    """
    h_fine = g_fine_bank[i].copy()

    matches = []
    for h_ref in g_coarse_waveforms:
        m, _ = match(h_fine, h_ref, psd=g_psd, low_frequency_cutoff=g_args.f_low)
        matches.append(m)

    matches = np.array(matches)
    morder = np.argsort(matches)[::-1]
    msearch = morder[:g_args.search_depth]

    def build_problem(c_idx):
        """Build the least-squares fit target for coarse template c_idx.

        Returns h_ref, the target frequency-domain ratio (H_target_raw),
        the in-band mask, and the PSD-based fit weights -- the inputs
        design_optimal_real_filter needs.
        """
        h_ref = g_coarse_waveforms[c_idx]
        freqs = h_fine.sample_frequencies.numpy()
        band_mask = (freqs >= g_args.f_low) & (freqs < g_args.sample_rate / 2.0)
        ratio = h_fine.numpy() / h_ref.numpy()

        # PSD based weights
        psd_np = g_psd.numpy()
        weights_snr = np.zeros_like(psd_np, dtype=np.float64)
        ref_mag = np.abs(h_ref.numpy())
        np.divide(ref_mag**2, psd_np, out=weights_snr, where=band_mask)

        # Clean up potential divide errors and normalize
        ratio = np.nan_to_num(ratio, copy=False)
        weights_snr = np.nan_to_num(weights_snr, copy=False)
        H_target_raw = ratio * g_args.sample_rate
        band_mask[abs(ratio) > g_args.ratio_cap] = False
        weights_snr /= weights_snr[band_mask].max()
        return h_ref, H_target_raw, band_mask, weights_snr

    def fit_and_verify(c_idx, h_ref, H_target_raw, band_mask, weights_snr, n_taps, peak_cap_factor):
        """Design a filter for c_idx at n_taps and check its match.

        Returns (qa, taps, sigmas, n_peak_passes, n_bins_capped, max_tap_val).
        qa is -1 (and sigmas None) if the fit is rejected outright for
        having an unsafely large tap value, without ever computing match.
        """
        taps, n_peak_passes, n_bins_capped = design_optimal_real_filter(
            H_target_raw[::g_args.dec_factor],
            band_mask[::g_args.dec_factor],
            n_taps, weights_pos=weights_snr[::g_args.dec_factor],
            reg_type=g_args.regularization_type,
            reg_val=g_args.regularization_magnitude,
            peak_cap_factor=peak_cap_factor,
            peak_bad_weight_fraction=g_args.peak_bad_weight_fraction,
            peak_max_passes=g_args.peak_max_passes)

        # Check if the taps are sane or if they contains a crazy number of
        # extreme / large values
        max_tap_val = np.max(np.abs(taps))
        if max_tap_val > g_args.max_tap_value:
            logging.warning(f"Template {i} (Ref {c_idx}, {n_taps} taps) rejected: Max tap value {max_tap_val:.2e} exceeded safety threshold.")
            return -1, taps, None, n_peak_passes, n_bins_capped, max_tap_val
        qa, sigmas = verify_filter_match(taps, h_ref, h_fine, g_psd, g_args.f_low)
        return qa, taps, sigmas, n_peak_passes, n_bins_capped, max_tap_val

    current_taps = g_args.n_taps

    best = (i, -1, -1, -1.0, [], [], 0, 0)
    best_unsuppressed = None  # (qa0, c_idx, best_match, n_taps), cheap to re-derive later
    accepted = False
    n_attempts_total = 0
    n_attempts_suppressed = 0

    while current_taps <= g_args.max_taps and not accepted:
        round_matches = []
        for c_idx in msearch:
            best_match = matches[c_idx]
            h_ref, H_target_raw, band_mask, weights_snr = build_problem(c_idx)

            try:
                qa0, taps0, sigmas0, _, _, max_tap0 = fit_and_verify(
                    c_idx, h_ref, H_target_raw, band_mask, weights_snr, current_taps, peak_cap_factor=0)
            except Exception as e:
                logging.info(e)
                continue
            round_matches.append(qa0)

            if best_unsuppressed is None or qa0 > best_unsuppressed[0]:
                best_unsuppressed = (qa0, c_idx, best_match, current_taps)

            logging.debug(f"CoarseTemp:{c_idx} QA-Match(unsuppressed):{qa0} Taps:{current_taps} Max Tap Val: {max_tap0}")

            if qa0 < g_args.min_match:
                # This attempt is escalating regardless of what suppression would
                # do to it (suppression can only hold or lower the match) -- skip
                # the extra fit passes.
                continue

            # A candidate for acceptance: confirm it still clears --min-match
            # once made numerically safe before actually committing to it.
            try:
                qa1, taps1, sigmas1, n_pp1, n_bc1, max_tap1 = fit_and_verify(
                    c_idx, h_ref, H_target_raw, band_mask, weights_snr, current_taps,
                    peak_cap_factor=g_args.peak_cap_factor)
            except Exception as e:
                logging.info(e)
                continue
            n_attempts_total += 1
            if n_pp1 > 0:
                n_attempts_suppressed += 1

            logging.debug(f"CoarseTemp:{c_idx} QA-Match(suppressed):{qa1} Taps:{current_taps} Max Tap Val: {max_tap1} "
                          f"PeakSuppression: passes={n_pp1} remaining_capped_bins={n_bc1}")

            if best[3] < qa1:
                best = (i, best_match, c_idx, qa1, taps1, sigmas1, n_pp1, n_bc1)

            if qa1 >= g_args.min_match:
                accepted = True
                break

        if accepted:
            break

        round_matches = np.array(round_matches)
        top = round_matches.argsort()[::-1]
        tnum = int(max(1, len(round_matches) * 0.8))
        msearch = msearch[top[:tnum]]
        current_taps += g_args.tap_step

    if not accepted and best_unsuppressed is not None:
        # Nothing ever cleared --min-match even before suppression. Apply the
        # mandatory safety pass once, to the single best (unsuppressed)
        # candidate found across the whole search, so whatever gets delivered
        # as this template's best effort is still numerically safe.
        qa0, c_idx, best_match, n_taps_at = best_unsuppressed
        h_ref, H_target_raw, band_mask, weights_snr = build_problem(c_idx)
        try:
            qa1, taps1, sigmas1, n_pp1, n_bc1, max_tap1 = fit_and_verify(
                c_idx, h_ref, H_target_raw, band_mask, weights_snr, n_taps_at,
                peak_cap_factor=g_args.peak_cap_factor)
            n_attempts_total += 1
            if n_pp1 > 0:
                n_attempts_suppressed += 1
            if best[3] < qa1:
                best = (i, best_match, c_idx, qa1, taps1, sigmas1, n_pp1, n_bc1)
        except Exception as e:
            logging.info(e)

    return best + (n_attempts_total, n_attempts_suppressed)

# --- 4. MAIN PROCESS ---
def main():
    parser = argparse.ArgumentParser(description="Generate Optimized FIR Filter Bank (MP)")
    pycbc.add_common_pycbc_options(parser)
    parser.add_argument('--coarse-bank', required=True)
    parser.add_argument('--fine-bank', required=True)
    parser.add_argument('--output-file', required=True)
    parser.add_argument('--f-low', type=float, default=20.0)
    parser.add_argument('--sample-rate', type=float, default=2048.0)
    parser.add_argument('--delta-f', type=float, default=None, required=True)
    parser.add_argument('--n-taps', type=int, default=251)
    parser.add_argument('--max-taps', type=int, default=1025)
    parser.add_argument('--tap-step', type=int, default=100)
    parser.add_argument('--min-match', type=float, default=0.99)
    parser.add_argument('--n-processes', '-n', type=int, default=1)
    parser.add_argument('--regularization-type', default='ridge', type=str)
    parser.add_argument('--regularization-magnitude', default=1e-1, type=float)
    parser.add_argument('--decimation-factor', default=1, type=int, dest='dec_factor')
    parser.add_argument('--search-depth', default=3, type=int,
                        help="Number of coarse templates to check for a good FIR representation")
    parser.add_argument('--ratio-cap', default=1000, type=int,
                        help="Don't fit ratio values above this number to avoid numerical instability of the fitting procedure")
    parser.add_argument('--max-tap-value', default=1e5, type=float,
                        help="If the calculated taps are larger in magnitude than this value, consider the constructionf failed")
    parser.add_argument('--peak-cap-factor', default=10.0, type=float,
                        help="After fitting, any frequency bin (checked across the full band, not just the "
                             "fitted region) whose achieved magnitude exceeds this many times the filter's own "
                             "median magnitude is nudged toward zero and the filter is refit. Guards against "
                             "single-precision numerical instability from a handful of unconstrained, "
                             "out-of-band bins with enormous gain. Set to 0 to disable.")
    parser.add_argument('--peak-bad-weight-fraction', default=1.0, type=float,
                        help="Weight given to the zero-target rows added for bins exceeding --peak-cap-factor, "
                             "relative to a typical in-band fit row.")
    parser.add_argument('--peak-max-passes', default=3, type=int,
                        help="Maximum number of fit/detect/constrain refinement passes for peak suppression.")
    pycbc.psd.insert_psd_option_group(parser)
    args = parser.parse_args()

    pycbc.init_logging(args.verbose)

    # Reroute logger to stdout to avoid tqdm conflict
    log = logging.getLogger()
    if args.verbose > 0 and log.handlers:
        if isinstance(log.handlers[0], logging.StreamHandler):
            log.handlers[0].stream = sys.stdout

    f_final = args.sample_rate / 2.0
    flen = int(f_final / args.delta_f) + 1
    logging.info(f"Setup: Rate={args.sample_rate}, df={args.delta_f}, flen={flen}")

    psd = pycbc.psd.from_cli(args, length=flen, delta_f=args.delta_f,
                             low_frequency_cutoff=args.f_low)

    logging.info("Loading coarse bank references...")
    coarse_bank = FilterBank(args.coarse_bank, flen, args.delta_f,
                             dtype=np.complex128,
                             enable_compressed_waveforms=False)
    show_progress = (args.verbose == 0)
    coarse_waveforms = [h.copy() for h in tqdm(coarse_bank, desc="Generating References", disable=not show_progress, file=sys.stderr)]

    if not coarse_waveforms: sys.exit("ERROR: Coarse bank empty!")

    logging.info("Opening fine bank...")
    fine_bank = FilterBank(args.fine_bank, flen, args.delta_f,
                           dtype=np.complex128,
                           enable_compressed_waveforms=False)
    n_fine = len(fine_bank)

    # --- PHASE 1: Write File Headers via TemplateBank reuse ---
    logging.info("Writing bank parameters to output file...")

    # 1. Write Fine Bank to Root
    f_out = fine_bank.write_to_hdf(args.output_file, force=True,
                                   write_compressed_waveforms=True)

    # 2. Write Coarse Bank to Subgroup
    coarse_bank.write_to_hdf(args.output_file, file_handler=f_out,
                             group_key="fir_data/coarse_bank_params",
                             write_compressed_waveforms=True)

    # 3. Add Metadata attributes
    # We use require_group because the previous step created 'fir_data/coarse_bank_params'
    fir_group = f_out.require_group("fir_data")
    for arg, val in vars(args).items():
        if val is not None and isinstance(val, (int, float, str)):
             fir_group.attrs[arg] = val

    # --- PHASE 2: Calculation Loop ---
    logging.info(f"Starting pool with {args.n_processes} processes...")
    failed_count = 0
    peak_suppressed_count = 0
    peak_still_capped_count = 0
    total_attempts = 0
    total_attempts_suppressed = 0
    job_list = range(n_fine)
    all_results = [None] * n_fine

    try:
        with mp.Pool(processes=args.n_processes, initializer=init_worker,
                     initargs=(coarse_waveforms, fine_bank, psd, args)) as pool:

            results_iter = pool.imap_unordered(process_template, job_list)
            if not args.verbose:
                 results_iter = tqdm(results_iter, total=n_fine, desc="Designing Filters",
                                     postfix={"failed": 0}, file=sys.stderr)

            for result in results_iter:
                (i, coarse_match, c_idx, qa_match, final_taps_data, sigmas, n_peak_passes, n_bins_capped,
                 n_attempts_total, n_attempts_suppressed) = result
                all_results[i] = (coarse_match, c_idx, qa_match, final_taps_data, sigmas)

                is_fail = (c_idx == -1) or (qa_match < args.min_match)
                if is_fail:
                    failed_count += 1
                if n_peak_passes > 0:
                    peak_suppressed_count += 1
                if n_bins_capped > 0:
                    peak_still_capped_count += 1
                total_attempts += n_attempts_total
                total_attempts_suppressed += n_attempts_suppressed

                if not args.verbose:
                    results_iter.set_postfix(failed=failed_count, peak_supp=peak_suppressed_count)

                if args.verbose >= 1:
                    mismatch = 1.0 - qa_match
                    logging.info(f"T{i} (Ref {c_idx}): Coarse={coarse_match:.4f}, Taps={len(final_taps_data)}, "
                                 f"Final={qa_match:.5f}, Mism={mismatch:.5e}, "
                                 f"PeakSuppression: passes={n_peak_passes} remaining_capped_bins={n_bins_capped}")
                    log.handlers[0].flush() # Flush stdout

        # --- PHASE 3: Write Results ---
        logging.info("All templates processed. Writing grouped results to HDF5...")

        results_by_coarse_idx = defaultdict(list)
        for i, res in enumerate(all_results):
            if res is None: continue
            c_idx = res[1]
            if c_idx != -1:
                results_by_coarse_idx[c_idx].append(res + (i,))

        tap_counts = []
        for c_idx, results_list in results_by_coarse_idx.items():
            c_group = fir_group.create_group(str(c_idx))
            n_group = len(results_list)

            k_max_group = max([len(r[3]) for r in results_list] + [1])

            # Use gzip compression for the large tap arrays
            dset_taps = c_group.create_dataset('taps', (n_group, k_max_group), dtype='float32',
                                              chunks=(1, k_max_group), compression="gzip", compression_opts=4)
            dset_actual = c_group.create_dataset('actual_tap_count', (n_group,), dtype='int32',
                                                 chunks=True, compression="gzip", compression_opts=4)
            dset_fine_idx = c_group.create_dataset('fine_bank_index', (n_group,), dtype='int32',
                                                   chunks=True, compression="gzip", compression_opts=4)
            dset_match = c_group.create_dataset('filter_match', (n_group,), dtype='float32',
                                                chunks=True, compression="gzip", compression_opts=4)
            dset_c_match = c_group.create_dataset('coarse_match', (n_group,), dtype='float32',
                                                  chunks=True, compression="gzip", compression_opts=4)
            dset_c_sigma = c_group.create_dataset('sigmas', (n_group, 3), dtype='float32',
                                                  chunks=True, compression="gzip", compression_opts=4)


            for j, result in enumerate(results_list):
                coarse_match, _, qa_match, final_taps_data, sigma, i = result

                taps_padded = np.zeros(k_max_group, dtype=np.float32)
                taps_padded[:len(final_taps_data)] = final_taps_data.astype(np.float32)

                dset_taps[j, :] = taps_padded
                dset_actual[j] = len(final_taps_data)
                dset_fine_idx[j] = i
                dset_match[j] = qa_match
                dset_c_match[j] = coarse_match
                dset_c_sigma[j] = sigma
            tap_counts.append(dset_actual[:])

        logging.info(f"Done. Saved to {args.output_file}")

    finally:
        f_out.close()

    tap_ave = np.mean(np.concatenate(tap_counts))
    summary_msg = f"Summary: {failed_count}/{n_fine} templates failed QA (<{args.min_match}).\n"
    summary_msg += f"Average taps: {tap_ave}\n"
    summary_msg += (f"Peak suppression triggered for the FINAL accepted filter of {peak_suppressed_count}/{n_fine} "
                     f"templates (achieved out-of-band gain exceeded {args.peak_cap_factor}x the filter's own "
                     f"median); {peak_still_capped_count}/{n_fine} still had bins above that cap after "
                     f"{args.peak_max_passes} refinement passes.\n")
    if total_attempts > 0:
        summary_msg += (f"Across the {total_attempts} attempts where peak suppression was actually evaluated (a "
                         f"candidate accepted before suppression, or the final best-effort fallback -- cheap "
                         f"escalation steps that were going to be superseded regardless skip the check), it "
                         f"triggered on {total_attempts_suppressed} "
                         f"({100.0 * total_attempts_suppressed / total_attempts:.1f}%).\n")

    if failed_count > 0 or peak_still_capped_count > 0: logging.warning(summary_msg)
    else: logging.info(summary_msg)

if __name__ == '__main__':
    mp.freeze_support()
    main()
