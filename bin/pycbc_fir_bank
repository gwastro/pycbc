#!/usr/bin/env python
"""Generate an Optimized Hierarchical FIR Filter Bank.

Constructs 2-level or multi-level hierarchical FIR filter banks for gravitational-wave
matched filtering. Selects coarse parent templates via bottom-up dispersion clustering,
designs interpolating FIR filters with Toeplitz least-squares and out-of-band peak
suppression, and prunes redundant parent groups. The hierarchy is real-real-complex:
the final (level 1) taps are complex (complex64) and the taps above them real (float32).
"""

import argparse
import atexit
import logging
import multiprocessing as mp
import sys
from collections import defaultdict
from pathlib import Path

import numpy as np
from scipy.fft import ifft, irfft, rfft
from scipy.linalg import solve_toeplitz
from tqdm import tqdm

import pycbc
import pycbc.conversions
import pycbc.psd
from pycbc.filter import get_cutoff_indices
from pycbc.waveform import compress
from pycbc.waveform.bank import FilterBank

logger = logging.getLogger(__name__)

# --- GLOBAL WORKER STATE (Inherited via fork in worker processes) ---
g_coarse_np, g_coarse_norm_sq, g_coarse_tau0 = None, None, None
g_coarse_kmax, g_coarse_fit, g_coarse_map = None, None, None
g_fine_bank, g_fine_tau0, g_cfg = None, None, None
g_inv_psd, g_delta_f, g_fft_len, g_valid_band = None, None, None, None
g_seed_of = None


def _set_bank_grid(bank, fft_len, sample_rate, min_f_low=None):
    """Configure frequency-domain grid parameters on `bank` for `fft_len`."""
    bank.N = int(fft_len)
    bank.filter_length = bank.N // 2 + 1
    bank.delta_f = float(sample_rate) / bank.N
    bank.delta_t = 1.0 / float(sample_rate)
    if min_f_low is not None:
        bank.min_f_lower = float(min_f_low)


def init_level_state(fine_bank, psd, f_low, cfg):
    """Initialize spectral grid, inverse PSD weights, and bank state for a level."""
    global g_fine_bank, g_fine_tau0, g_cfg  # noqa: PLW0603
    global g_inv_psd, g_delta_f, g_fft_len, g_valid_band  # noqa: PLW0603

    g_cfg = cfg
    g_fine_bank = fine_bank
    g_fine_tau0 = np.asarray(
        pycbc.conversions.tau0_from_mass1_mass2(
            fine_bank.table["mass1"], fine_bank.table["mass2"], f_low
        ),
        dtype=float,
    )

    g_delta_f = float(psd.delta_f)
    psd_arr = psd.numpy().astype(np.float64)
    g_fft_len = 2 * (len(psd_arr) - 1)

    # Inverse PSD zeroed outside [f_low, Nyquist) so inner products need no slicing
    k_min, k_max = get_cutoff_indices(f_low, None, g_delta_f, g_fft_len)
    g_inv_psd = np.zeros_like(psd_arr)
    np.divide(1.0, psd_arr, out=g_inv_psd, where=psd_arr > 0)
    g_inv_psd[:k_min] = 0.0
    g_inv_psd[k_max:] = 0.0
    g_valid_band = g_inv_psd > 0


def _get_waveform(index):
    """Generate template waveform on current level grid with PSD norm^2 and cutoff."""
    h = g_fine_bank[int(index)].numpy().astype(complex)
    step = (len(h) - 1) // (g_fft_len // 2)
    if step > 1:
        h = h[::step]
    norm_sq = float(np.dot(h.real**2 + h.imag**2, g_inv_psd))
    nz = np.flatnonzero(g_valid_band & (h != 0))
    return h, norm_sq, (int(nz[-1]) if len(nz) else 0)


def _cache_parent_templates(indices):
    """Cache parent waveforms, PSD norms, and cutoff bins in worker globals."""
    global g_coarse_np, g_coarse_norm_sq, g_coarse_tau0  # noqa: PLW0603
    global g_coarse_kmax, g_coarse_fit, g_coarse_map  # noqa: PLW0603

    idx = np.asarray(indices, dtype=int)
    waves = [_get_waveform(i) for i in idx]
    g_coarse_np = [w[0] for w in waves]
    g_coarse_norm_sq = [w[1] for w in waves]
    g_coarse_kmax = np.array([w[2] for w in waves], dtype=int)
    g_coarse_tau0 = g_fine_tau0[idx]
    g_coarse_fit = [None] * len(idx)
    g_coarse_map = {int(fine_i): k for k, fine_i in enumerate(idx)}


def estimate_fir_taps(h1_np, h2_np):
    """Estimate required FIR taps via PSD-weighted group delay dispersion."""
    h1_nz, h2_nz = h1_np != 0, h2_np != 0
    active = g_valid_band & h1_nz & h2_nz
    if np.count_nonzero(active) < 2 or np.any(g_valid_band & h2_nz & ~h1_nz):
        return np.inf
    cross = h2_np[active] * np.conj(h1_np[active])
    w = np.abs(cross) * g_inv_psd[active]
    w_sum = np.sum(w)
    if w_sum <= 0:
        return np.inf
    w /= w_sum
    dphi = np.unwrap(np.angle(cross))
    group_delay = -np.gradient(dphi, g_delta_f) / (2.0 * np.pi) * g_cfg["sample_rate"]
    std_delay = np.sqrt(np.sum((group_delay - np.sum(group_delay * w)) ** 2 * w))
    return 4.0 * std_delay


def spectrum_to_correlation(spec):
    """Compute real time-domain autocorrelation from positive-frequency weights."""
    half = np.array(spec, dtype=np.complex128, copy=True)
    half[0] *= 2.0
    half[-1] *= 2.0
    return (0.5 * g_fft_len) * irfft(half, n=g_fft_len)


def fit_fir_filter(cand_idx, fine_np, fine_norm_sq, max_taps, binary_search=True):
    """Fit an interpolating FIR filter from parent `cand_idx` to `fine_np`.

    When `binary_search` is True, binary-searches odd tap counts in [1, max_taps]
    for the shortest filter achieving `min_match`; otherwise evaluates `max_taps` only.
    Returns a result dict on success or None if `min_match` is not met.
    """
    cand_idx = int(cand_idx)
    max_taps = min(int(max_taps), g_fft_len - 1)
    max_taps -= max_taps % 2 == 0
    if max_taps < 1:
        return None

    ref_np = g_coarse_np[cand_idx]
    sr = g_cfg["sample_rate"]
    is_complex = g_cfg["complex_taps"]

    # Cache parent PSD weights and autocorrelation on first use
    ref_fit = g_coarse_fit[cand_idx]
    if ref_fit is None:
        band = g_valid_band & (ref_np != 0)
        w2 = (ref_np.real**2 + ref_np.imag**2) * g_inv_psd
        w2_max = float(w2.max())
        if w2_max <= 0:
            g_coarse_fit[cand_idx] = False
            return None
        w2 /= w2_max
        ref_fit = (
            band,
            w2,
            np.conj(ref_np) * (g_inv_psd * (sr / w2_max)),
            float(np.sum(w2)),
            float(np.median(w2[band])),
            float(w2_max / (sr**2)),
            spectrum_to_correlation(w2),
        )
        g_coarse_fit[cand_idx] = ref_fit
    elif ref_fit is False:
        return None

    band, w2, ref_weight, w2_sum, typ_w2, w2_scale, r_base = ref_fit
    target_w2 = fine_np * ref_weight

    # Estimate bulk integer sample shift from PSD-weighted mean group delay
    shift = 0
    overlap_bins = np.flatnonzero(band & (fine_np != 0))
    if len(overlap_bins) >= 2 and w2[overlap_bins].sum() > 0:
        gd = (
            -np.gradient(np.unwrap(np.angle(target_w2[overlap_bins])), g_delta_f)
            / (2.0 * np.pi)
            * sr
        )
        shift = int(np.round(np.sum(gd * w2[overlap_bins]) / np.sum(w2[overlap_bins])))

    c_full = ifft(target_w2, n=g_fft_len) * g_fft_len
    b_base = c_full if is_complex else c_full.real
    ref_norm_sq = g_coarse_norm_sq[cand_idx]

    def _solve(n_taps):
        pos = (np.arange(n_taps) - n_taps // 2 + shift) % g_fft_len
        b, c_pos = b_base[pos], c_full[pos]
        fitted = band.copy()
        w2_cur = None

        # Solve Toeplitz normal equations and iteratively suppress out-of-band spikes
        for attempt in range(4):
            r_col = (
                r_base[:n_taps].copy()
                if attempt == 0
                else spectrum_to_correlation(w2_cur)[:n_taps].copy()
            )
            r_col[0] += g_cfg["reg"]
            taps = np.asarray(
                solve_toeplitz(r_col, b),
                dtype=np.complex64 if is_complex else np.float32,
            )

            if is_complex:
                resp_re = rfft(taps.real.astype(np.float64), n=g_fft_len)
                resp_im = rfft(taps.imag.astype(np.float64), n=g_fft_len)
                mags2_re = resp_re.real**2 + resp_re.imag**2
                mags2_im = resp_im.real**2 + resp_im.imag**2
                mags2 = np.maximum(mags2_re, mags2_im)
            else:
                resp = rfft(taps.astype(np.float64), n=g_fft_len)
                mags2 = resp.real**2 + resp.imag**2

            w2_mags2 = float(np.dot(w2, mags2))
            bad = (mags2 > 100.0 * (w2_mags2 / w2_sum)) & ~fitted
            if not np.any(bad) or attempt == 3:
                break
            if w2_cur is None:
                w2_cur = w2.copy()
            w2_cur[bad] = typ_w2
            fitted |= bad

        def _eval_branch(taps_branch, branch_mags2_sum):
            rec_norm_sq = branch_mags2_sum * w2_scale
            if rec_norm_sq <= 0:
                return 0.0, 0.0
            ip = np.vdot(c_pos, taps_branch) * w2_scale
            num = float(np.real(ip)) if is_complex else float(abs(ip))
            return num / float(np.sqrt(rec_norm_sq * fine_norm_sq)), rec_norm_sq

        norm_scale = (1.0 / sr) if g_cfg["scale_by_sr"] else 1.0
        if is_complex:
            m_re, rec_re = _eval_branch(taps.real, float(np.dot(w2, mags2_re)))
            m_im, rec_im = _eval_branch(1j * taps.imag, float(np.dot(w2, mags2_im)))
            if rec_re <= 0 or rec_im <= 0:
                return None
            taps.real *= np.float32(np.sqrt(ref_norm_sq / rec_re) * norm_scale)
            taps.imag *= np.float32(np.sqrt(ref_norm_sq / rec_im) * norm_scale)
            overlap = min(m_re, m_im)
        else:
            overlap, rec_re = _eval_branch(taps, w2_mags2)
            if rec_re <= 0:
                return None
            taps *= np.float32(np.sqrt(ref_norm_sq / rec_re) * norm_scale)

        if not (np.isfinite(overlap) and overlap >= g_cfg["min_match"]):
            return None
        ref_sigma = float(np.sqrt(4.0 * g_delta_f * ref_norm_sq))
        tgt_sigma = float(np.sqrt(4.0 * g_delta_f * fine_norm_sq))
        return {
            "c_idx": cand_idx,
            "n_taps": n_taps,
            "match": overlap,
            "taps": taps,
            "sigmas": (ref_sigma, tgt_sigma),
            "shift": shift,
        }

    best = _solve(max_taps)
    if best is None or not binary_search:
        return best
    lo_idx, hi_idx = 0, (max_taps - 1) // 2
    while lo_idx < hi_idx:
        mid_idx = (lo_idx + hi_idx) // 2
        rec = _solve(2 * mid_idx + 1)
        if rec is not None:
            hi_idx, best = mid_idx, rec
        else:
            lo_idx = mid_idx + 1
    return best


def process_template(task):
    """Match fine waveform to best coarse parent and determine minimal FIR taps."""
    fine_idx, excluded = task if isinstance(task, tuple) else (task, None)
    slot = g_coarse_map.get(int(fine_idx))
    if slot is not None:
        fine_np, fine_norm_sq, fine_kmax = (
            g_coarse_np[slot],
            g_coarse_norm_sq[slot],
            int(g_coarse_kmax[slot]),
        )
    else:
        fine_np, fine_norm_sq, fine_kmax = _get_waveform(fine_idx)

    # Pre-filter candidate parents by bandwidth, chirp time, and tap estimate
    allowed = np.arange(len(g_coarse_np))
    if excluded:
        allowed = allowed[~np.isin(allowed, list(excluded))]
    if len(allowed):
        covering = allowed[g_coarse_kmax[allowed] >= fine_kmax]
        if len(covering):
            allowed = covering
    if len(allowed) > 32:
        allowed = allowed[
            np.argsort(np.abs(g_coarse_tau0[allowed] - g_fine_tau0[fine_idx]))[:32]
        ]
    k_ests = [estimate_fir_taps(g_coarse_np[c], fine_np) for c in allowed]
    candidates = allowed[np.argsort(k_ests)[:8]]
    # The seed that absorbed this template during seeding is known to fit it,
    # so it is always tried, even if the cuts above dropped it
    seed_slot = (
        g_coarse_map.get(g_seed_of.get(int(fine_idx), -1)) if g_seed_of else None
    )
    if (
        seed_slot is not None
        and seed_slot not in candidates
        and (not excluded or seed_slot not in excluded)
    ):
        candidates = np.append(candidates, seed_slot)

    best = None
    for cand_idx in candidates:
        top = g_cfg["max_taps"] if best is None else best["n_taps"] - 2
        rec = fit_fir_filter(cand_idx, fine_np, fine_norm_sq, top)
        if rec is not None:
            best = rec
    return fine_idx, best


def _seed_worker(indices):
    """Select greedy dispersion-clustered seeds within a tau0-sorted chunk.

    Returns the seeds, and a map from each template to the seed that
    absorbed it (a seed absorbs itself).
    """
    _cache_parent_templates(indices)
    max_taps = min(g_cfg["max_taps"], g_fft_len - 1)
    unassigned = list(np.argsort(-g_coarse_kmax, kind="stable"))
    seeds, seed_of = [], {}
    while unassigned:
        seed = unassigned[0]
        seed_np = g_coarse_np[seed]
        remaining = [
            c
            for c in unassigned[1:]
            if estimate_fir_taps(seed_np, g_coarse_np[c]) > max_taps
            or fit_fir_filter(
                seed,
                g_coarse_np[c],
                g_coarse_norm_sq[c],
                max_taps,
                binary_search=False,
            )
            is None
        ]
        for c in set(unassigned) - set(remaining):
            seed_of[int(indices[c])] = int(indices[seed])
        unassigned = remaining
        seeds.append(int(indices[seed]))
    return seeds, seed_of


def main():
    mp.set_start_method("fork", force=True)
    parser = argparse.ArgumentParser(description=__doc__)
    pycbc.add_common_pycbc_options(parser)
    pycbc.psd.insert_psd_option_group(parser)
    parser.add_argument("--fine-bank", required=True, help="Input fine bank HDF5 file.")
    parser.add_argument(
        "--output-file", required=True, help="Output FIR bank HDF5 file."
    )
    parser.add_argument(
        "--segment-length",
        type=float,
        required=True,
        help="Segment length in seconds for generating top-level waveforms.",
    )
    parser.add_argument(
        "--sample-rate", type=float, default=2048.0, help="Sample rate."
    )
    parser.add_argument(
        "-n", "--n-processes", type=int, default=1, help="Worker count."
    )
    parser.add_argument("--force", action="store_true", help="Overwrite output file.")
    parser.add_argument(
        "--min-match",
        nargs="+",
        type=float,
        default=[0.9999],
        help="Min match per level.",
    )
    parser.add_argument(
        "--max-taps", nargs="+", type=int, default=[301], help="Max taps per level."
    )
    parser.add_argument(
        "--full-resolution",
        action="store_true",
        help="Generate waveforms at full segment-length resolution before "
        "downsampling to each FIR level's fitting grid.",
    )
    args = parser.parse_args()

    num_levels = len(args.max_taps)
    if len(args.min_match) not in (1, num_levels):
        sys.exit(f"Error: --min-match must have 1 or {num_levels} values")
    if Path(args.output_file).exists() and not args.force:
        sys.exit(f"Error: {args.output_file} exists (use --force)")

    pycbc.init_logging(args.verbose)
    sr = float(args.sample_rate)
    full_fft_len = 1 << max(1, round(sr * args.segment_length) - 1).bit_length()
    fine_bank = FilterBank(
        args.fine_bank,
        full_fft_len // 2 + 1,
        sr / full_fft_len,
        dtype=complex,
        enable_compressed_waveforms=False,
    )
    orig_table = fine_bank.table
    out_file = fine_bank.write_to_hdf(
        args.output_file, force=True, write_compressed_waveforms=True
    )
    # Remove a half-written bank if the run does not reach the end
    remove_partial = atexit.register(Path(args.output_file).unlink, missing_ok=True)

    fir_group = out_file.require_group("fir_data")
    fir_group.attrs["num_levels"] = int(num_levels)
    fir_group.attrs["sample_rate"] = sr
    fir_group.attrs["min_match"] = float(args.min_match[0])

    n_procs = args.n_processes
    level_links = []

    # Index in the input bank of each template the current level fits
    orig_index = np.arange(len(fine_bank))
    for level in range(1, num_levels + 1):
        is_lowest = level == 1
        label = f"level_{level}"
        max_taps = int(args.max_taps[level - 1])
        fft_len = 1 << max(1, 8 * max_taps - 1).bit_length()
        min_match = float(
            args.min_match[level - 1] if len(args.min_match) > 1 else args.min_match[0]
        )
        min_f_low = float(np.min(fine_bank.table["f_lower"]))
        _set_bank_grid(
            fine_bank,
            max(fft_len, full_fft_len) if args.full_resolution else fft_len,
            sr,
            min_f_low=min_f_low,
        )

        cfg = {
            "sample_rate": sr,
            "max_taps": max_taps,
            "min_match": min_match,
            "reg": 1e-2 if is_lowest else 1e-6,
            "complex_taps": is_lowest,
            "scale_by_sr": not is_lowest,
        }
        psd = pycbc.psd.from_cli(
            args,
            length=fft_len // 2 + 1,
            delta_f=sr / fft_len,
            low_frequency_cutoff=min_f_low,
        )

        # 1. Select initial parent templates via greedy dispersion clustering
        logger.info("Bottom-up seeding: selecting %s templates...", label)
        init_level_state(fine_bank, psd, min_f_low, cfg)
        order = np.lexsort((g_fine_tau0, np.asarray(fine_bank.table["f_lower"], float)))
        chunks = [c for c in np.array_split(order, max(1, n_procs)) if len(c)]
        global g_seed_of
        seeds, g_seed_of = [], {}
        with mp.Pool(processes=max(1, min(n_procs, len(chunks)))) as pool:
            for chunk_seeds, chunk_seed_of in tqdm(
                pool.imap_unordered(_seed_worker, chunks),
                total=len(chunks),
                desc=f"Seeding {label}",
                disable=bool(args.verbose),
                file=sys.stderr,
            ):
                seeds.extend(chunk_seeds)
                g_seed_of.update(chunk_seed_of)
        seed_local = np.array(sorted(seeds), dtype=int)
        _cache_parent_templates(seed_local)

        # 2. Fit each child template to its lowest-tap parent and prune redundant groups
        n_children = len(fine_bank)
        results = [None] * n_children
        chunksize = max(1, min(n_children // (2 * n_procs), 8))
        with mp.Pool(processes=n_procs) as pool:
            it = pool.imap_unordered(
                process_template, range(n_children), chunksize=chunksize
            )
            if not args.verbose:
                it = tqdm(
                    it, total=n_children, desc=f"Fitting {label}", file=sys.stderr
                )
            for fine_idx, rec in it:
                if rec is None:
                    msg = (
                        f"{label} template {fine_idx} (input bank index "
                        f"{orig_index[fine_idx]}) failed min_match {min_match}"
                    )
                    raise RuntimeError(msg)
                results[fine_idx] = rec

            # Prune redundant parent groups
            groups = defaultdict(list)
            for i, rec in enumerate(results):
                groups[rec["c_idx"]].append(i)
            n_used = len(groups)
            unused = set(range(len(g_coarse_np))) - set(groups)
            removed = set()
            for parent in sorted(groups, key=lambda p: (len(groups[p]), p)):
                children = list(groups[parent])
                if not children:
                    continue
                excluded = frozenset(unused | removed | {parent})
                seed_child = int(seed_local[parent])
                reassignments, absorbed = {}, True
                if seed_child in children:
                    _, seed_rec = process_template((seed_child, excluded))
                    if seed_rec is None:
                        continue
                    reassignments[seed_child] = seed_rec
                    children.remove(seed_child)
                for c_idx, rec in pool.imap_unordered(
                    process_template, [(c, excluded) for c in children], chunksize=1
                ):
                    if rec is None:
                        absorbed = False
                        break
                    reassignments[c_idx] = rec
                if not absorbed:
                    continue
                for c_idx, rec in reassignments.items():
                    results[c_idx] = rec
                    groups[rec["c_idx"]].append(c_idx)
                groups[parent] = []
                removed.add(parent)
                logger.info(
                    "Pruned %s parent %d (%d children)", label, parent, len(children)
                )
            logger.info(
                "Seed pruning: %d -> %d %s templates in use",
                n_used,
                n_used - len(removed),
                label,
            )

        used_pos = np.array(sorted(p for p, ch in groups.items() if ch), dtype=int)
        fine_bank.table = fine_bank.table[seed_local[used_pos]]
        orig_index = orig_index[seed_local[used_pos]]

        # Write level datasets to HDF5
        lvl_group = fir_group.require_group(label)
        lvl_group.attrs["max_taps"] = max_taps
        meta_kw = {
            "compression": "gzip",
            "compression_opts": 9,
            "shuffle": True,
            "chunks": True,
        }
        taps_kw = {
            "compression": "gzip",
            "compression_opts": 9,
            "shuffle": not is_lowest,
        }
        lvl_map = {}
        for new_idx, old_idx in enumerate(used_pos):
            child_ids = sorted(groups[int(old_idx)])
            recs = [results[i] for i in child_ids]
            for cid, r in zip(child_ids, recs, strict=False):
                lvl_map[int(cid)] = (new_idx, r["taps"], int(r["shift"]))
            grp = lvl_group.create_group(str(new_idx))
            counts = np.array([len(r["taps"]) for r in recs], dtype=np.int32)
            max_k = int(counts.max())
            taps_arr = np.zeros(
                (len(recs), max_k), dtype=np.complex64 if is_lowest else np.float32
            )
            for j, r in enumerate(recs):
                taps_arr[j, : counts[j]] = r["taps"]
            grp.create_dataset(
                "taps", data=taps_arr, chunks=(len(recs), max_k), **taps_kw
            )
            grp.create_dataset("actual_tap_count", data=counts, **meta_kw)
            grp.create_dataset(
                "fine_bank_index", data=np.array(child_ids, np.int32), **meta_kw
            )
            grp.create_dataset(
                "sigmas",
                data=np.array([r["sigmas"] for r in recs], np.float32),
                **meta_kw,
            )
            grp.create_dataset(
                "sample_shift",
                data=np.array([r["shift"] for r in recs], np.int32),
                **meta_kw,
            )
        level_links.append(lvl_map)

    # Compress top-level reference waveforms into level_{num_levels}
    top_lvl_group = fir_group[f"level_{num_levels}"]
    comp_fft_len = round(sr * float(args.segment_length))
    comp_tol = min(1e-5, (1.0 - float(args.min_match[-1])) * 0.1)
    _set_bank_grid(fine_bank, comp_fft_len, sr)
    logger.info(
        "Compressing %d top-level reference waveforms (df=%s, tol=%.1e)...",
        len(fine_bank),
        fine_bank.delta_f,
        comp_tol,
    )
    top_decomp = {}
    for i in range(len(fine_bank)):
        wave = fine_bank[i]
        fmin = float(fine_bank.table[i].f_lower)
        kmax = int(np.nonzero(abs(wave.numpy()))[0][-1])
        hc = compress.compress_waveform(
            wave,
            np.array([fmin, kmax * fine_bank.delta_f], float),
            comp_tol,
            "inline_quadratic",
            "single",
            psd=None,
        )
        if hc.mismatch > comp_tol:
            logger.warning(
                "Top-level reference %d (input bank index %d) compressed with "
                "mismatch %.2e, above the tolerance %.1e",
                i,
                orig_index[i],
                hc.mismatch,
                comp_tol,
            )
        hc.write_to_hdf(top_lvl_group, str(i))
        top_decomp[i] = (
            hc.decompress(
                out=pycbc.types.FrequencySeries(
                    pycbc.types.zeros(fine_bank.filter_length, dtype=np.complex64),
                    delta_f=fine_bank.delta_f,
                    copy=False,
                ),
                f_lower=fmin,
            )
            .numpy()
            .astype(np.complex128)
        )

    # End-to-end full-resolution spot check on a random sample of fine templates
    fine_bank.table = orig_table
    min_f_low = float(np.min(orig_table["f_lower"]))
    fine_bank.min_f_lower = min_f_low
    full_psd = pycbc.psd.from_cli(
        args,
        length=fine_bank.filter_length,
        delta_f=fine_bank.delta_f,
        low_frequency_cutoff=min_f_low,
    )
    init_level_state(fine_bank, full_psd, min_f_low, cfg)

    def _apply_fir(h_freq, taps_real, shift):
        pad = np.zeros(comp_fft_len, dtype=np.float64)
        pad[
            (np.arange(len(taps_real)) - len(taps_real) // 2 + int(shift))
            % comp_fft_len
        ] = taps_real
        return h_freq * rfft(pad, n=comp_fft_len)

    def _match(h_cand, h_true, n_true):
        n_cand = np.sqrt(np.dot(h_cand.real**2 + h_cand.imag**2, g_inv_psd))
        return float(
            np.dot((h_cand.conj() * h_true).real, g_inv_psd) / (n_cand * n_true)
        )

    rng = np.random.default_rng(0)
    sample_idxs = rng.choice(
        len(orig_table), size=min(32, len(orig_table)), replace=False
    )
    spot_matches = []
    for idx in sample_idxs:
        chain, cur = [], int(idx)
        for lvl_map in level_links:
            cur, t, s = lvl_map[cur]
            chain.append((t, s))
        h_rec = top_decomp[cur]
        for t, s in reversed(chain[1:]):
            h_rec = _apply_fir(h_rec, t.real, s)
        t1, s1 = chain[0]
        h_true = fine_bank[int(idx)].numpy().astype(np.complex128)
        n_true = np.sqrt(np.dot(h_true.real**2 + h_true.imag**2, g_inv_psd))
        m_re = _match(_apply_fir(h_rec, t1.real, s1), h_true, n_true)
        if np.iscomplexobj(t1):
            m_im = _match(1j * _apply_fir(h_rec, t1.imag, s1), h_true, n_true)
            spot_matches.append(min(m_re, m_im))
        else:
            spot_matches.append(abs(m_re))
    logger.info(
        "Full-resolution spot check (%d templates, df=%s): "
        "min=%.6f, median=%.6f, max=%.6f",
        len(spot_matches),
        fine_bank.delta_f,
        min(spot_matches),
        float(np.median(spot_matches)),
        max(spot_matches),
    )

    out_file.close()
    atexit.unregister(remove_partial)
    logger.info("Done. Saved to %s", args.output_file)


if __name__ == "__main__":
    main()
