#!/usr/bin/env python
"""
pycbc_inspiral_fir: A pipeline-compatible script for inspiral analysis
using the Ratio Matched Filter method.
"""

import argparse
import logging
import os
import time

import h5py
import numpy as np

import pycbc
import pycbc.events
import pycbc.fft
import pycbc.inject
import pycbc.psd
import pycbc.scheme
import pycbc.strain
import pycbc.types.optparse
import pycbc.vetoes
from pycbc.filter.matched_filter_ratio import MatchedFilterRatioControl
from pycbc.types import complex64, float32
from pycbc.vetoes.chain import SignalConsistencyChain
from pycbc.waveform.bank import RatioFilterBank

logger = logging.getLogger(__name__)
tstart = time.time()


def get_args():
    parser = argparse.ArgumentParser(description=__doc__)
    pycbc.add_common_pycbc_options(parser)

    # Standard PyCBC Data/Segment Options
    pycbc.strain.insert_strain_option_group_multi_ifo(parser)
    pycbc.strain.StrainSegments.insert_segment_option_group_multi_ifo(parser)
    pycbc.psd.insert_psd_option_group_multi_ifo(parser)
    pycbc.scheme.insert_processing_option_group(parser)
    pycbc.fft.insert_fft_option_group(parser)
    pycbc.inject.insert_injfilterrejector_option_group_multi_ifo(parser)
    SignalConsistencyChain.insert_option_group(parser)
    MatchedFilterRatioControl.insert_option_group(parser)

    # Analysis Options
    parser.add_argument("--output", required=True, help="Path to output HDF5 file.")
    parser.add_argument(
        "--instruments",
        nargs="+",
        type=str,
        help="List of instruments to analyze (defaults to keys of --channel-name).",
    )
    parser.add_argument(
        "--bank-file", type=str, required=True, help="Path to the HDF5 Ratio Bank file."
    )
    parser.add_argument(
        "--low-frequency-cutoff",
        type=float,
        help="The low frequency cutoff to use for filtering (Hz)",
    )

    # Event Handling
    parser.add_argument(
        "--finalize-events-template-rate",
        default=None,
        type=int,
        metavar="NUM TEMPLATES",
        help="After NUM TEMPLATES perform event consolidation.",
    )
    parser.add_argument(
        "--keep-loudest-log-chirp-window",
        type=float,
        help="Keep loudest triggers within ln chirp mass window",
    )
    parser.add_argument(
        "--keep-loudest-interval",
        type=float,
        help="Window in seconds to maximize triggers over bank",
    )
    parser.add_argument(
        "--keep-loudest-num",
        type=int,
        help="Number of triggers to keep from each maximization interval",
    )
    parser.add_argument(
        "--keep-loudest-stat",
        default="newsnr",
        choices=pycbc.events.ranking.sngls_ranking_function_dict.keys(),
        help="Statistic used to determine loudest to keep",
    )

    return parser, parser.parse_args()


def main():
    parser, args = get_args()
    pycbc.init_logging(args.verbose)

    instruments = sorted(args.instruments or args.channel_name.keys())
    pycbc.strain.verify_strain_options_multi_ifo(args, parser, instruments)
    pycbc.strain.StrainSegments.verify_segment_options_multi_ifo(
        args, parser, instruments
    )
    pycbc.psd.verify_psd_options_multi_ifo(args, parser, instruments)
    pycbc.scheme.verify_processing_options(args, parser)
    pycbc.fft.verify_fft_options(args, parser)
    pycbc.fft.from_cli(args)

    with pycbc.scheme.from_cli(args):
        inj_filter_rejector = pycbc.inject.InjFilterRejector.from_cli_multi_ifos(
            args, instruments
        )
        gwstrain = pycbc.strain.from_cli_multi_ifos(
            args, instruments, inj_filter_rejector, dyn_range_fac=pycbc.DYN_RANGE_FAC
        )
        strain_segments = pycbc.strain.StrainSegments.from_cli_multi_ifos(
            args, gwstrain, instruments
        )

        flow = args.low_frequency_cutoff
        if flow is None:
            with h5py.File(args.bank_file, "r") as f:
                if "f_lower" in f:
                    flow = float(np.min(f["f_lower"][:]))

        ifo0 = instruments[0]
        sample_rate = gwstrain[ifo0].sample_rate
        flen = strain_segments[ifo0].freq_len
        delta_f = strain_segments[ifo0].delta_f

        segments = {ifo: strain_segments[ifo].fourier_segments() for ifo in instruments}
        del strain_segments
        pycbc.psd.associate_psds_to_multi_ifo_segments(
            args,
            segments,
            gwstrain,
            flen,
            delta_f,
            flow,
            instruments,
            dyn_range_factor=pycbc.DYN_RANGE_FAC,
            precision="single",
        )

        ifo_opts = {}
        for ifo in instruments:
            opt_ifo = pycbc.types.optparse.copy_opts_for_single_ifo(args, ifo)
            opt_ifo.ifo = ifo
            ifo_opts[ifo] = opt_ifo

        out_types = {
            "time_index": int,
            "snr": complex64,
            "sigmasq": float32,
            **SignalConsistencyChain.columns,
        }
        if any(opt.psdvar_segment is not None for opt in ifo_opts.values()):
            out_types["psd_var_val"] = float32
        names = sorted(out_types.keys())
        event_mgr = {}
        for ifo in instruments:
            mgr = pycbc.events.EventManager(
                ifo_opts[ifo],
                names,
                [out_types[n] for n in names],
                psd=None,
                gating_info=getattr(gwstrain[ifo], "gating_info", None),
            )
            mgr.ifo = ifo
            event_mgr[ifo] = mgr

        logger.info("Initializing Ratio Filter Bank...")
        bank = RatioFilterBank(
            args.bank_file,
            filter_length=flen,
            delta_f=delta_f,
            dtype=np.complex64,
            low_frequency_cutoff=flow,
        )
        for rej in inj_filter_rejector.values():
            if rej is not None and rej.enabled:
                bank.template_thinning(rej)
                break

        veto_chain = SignalConsistencyChain.from_cli(args, bank, sample_rate)
        engine = MatchedFilterRatioControl.from_cli(args, bank, segments)

        tsetup = time.time() - tstart
        cluster_window = (
            int(args.cluster_window * sample_rate) if args.cluster_window else 0
        )

        triggers, has_followup = engine.run(veto_callback=veto_chain.values)

        for ifo in instruments:
            mgr = event_mgr[ifo]
            mgr.non_threshold_time = (
                engine.followup_window if has_followup[ifo] else 0.0
            )
            data = triggers[ifo]
            if not data or len(data.get("template_id", ())) == 0:
                continue

            opt_ifo = ifo_opts[ifo]
            if opt_ifo.psdvar_segment is not None:
                psd_var = pycbc.psd.calc_filt_psd_variation(
                    gwstrain[ifo],
                    opt_ifo.psdvar_segment,
                    opt_ifo.psdvar_short_segment,
                    opt_ifo.psdvar_long_segment,
                    opt_ifo.psdvar_psd_duration,
                    opt_ifo.psdvar_psd_stride,
                    opt_ifo.psd_estimation,
                    opt_ifo.psdvar_low_freq,
                    opt_ifo.psdvar_high_freq,
                )
                data["psd_var_val"] = pycbc.psd.find_trigger_value(
                    psd_var,
                    data["time_index"],
                    opt_ifo.gps_start_time,
                    sample_rate,
                )

            order = np.argsort(data["template_id"], kind="stable")
            data = {col: arr[order] for col, arr in data.items()}

            unique_gids, starts = np.unique(data["template_id"], return_index=True)
            ends = np.append(starts[1:], len(data["template_id"]))
            is_followup = data["is_followup"]

            for t_idx, (gid, s, e) in enumerate(
                zip(unique_gids, starts, ends, strict=False)
            ):
                mgr.new_template(tmplt=bank.table[int(gid)])

                # Add and cluster primary triggers first, then append follow-up triggers
                prim = s + np.flatnonzero(~is_followup[s:e])
                if len(prim):
                    mgr.add_template_events(names, [data[n][prim] for n in names])
                    if cluster_window > 0:
                        mgr.cluster_template_events("time_index", "snr", cluster_window)

                fup = s + np.flatnonzero(is_followup[s:e])
                if len(fup):
                    mgr.add_template_events(names, [data[n][fup] for n in names])

                mgr.finalize_template_events()
                if (
                    args.finalize_events_template_rate
                    and (t_idx + 1) % args.finalize_events_template_rate == 0
                ):
                    mgr.consolidate_events(ifo_opts[ifo], gwstrain=gwstrain[ifo])

    run_time = time.time() - tstart
    if os.path.exists(args.output):
        os.remove(args.output)

    cores_per_ifo = float(args.cores or 1) / len(instruments)
    for i, ifo in enumerate(instruments):
        mgr = event_mgr[ifo]
        mgr.save_performance(
            cores_per_ifo, len(segments[ifo]), len(bank), run_time, tsetup
        )
        logger.info("Consolidating and writing events for %s...", ifo)
        mgr.consolidate_events(ifo_opts[ifo], gwstrain=gwstrain[ifo])
        mgr.finalize_events()
        mgr.write_events(args.output, mode="w" if i == 0 else "a")

    logger.info("Finished.")


if __name__ == "__main__":
    main()
