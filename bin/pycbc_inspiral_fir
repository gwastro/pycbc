#!/usr/bin/env python
"""
pycbc_inspiral_ratio: A pipeline-compatible script for inspiral analysis
using the Ratio Matched Filter method.
"""

import argparse
import logging
import time

import numpy as np

import pycbc
import pycbc.events
import pycbc.fft
import pycbc.inject
import pycbc.psd
import pycbc.scheme
import pycbc.strain
import pycbc.vetoes

# --- Imports for Ratio Logic ---
from pycbc.filter.matched_filter_ratio import MatchedFilterRatioControl
from pycbc.types import complex64, float32
from pycbc.vetoes.chain import SignalConsistencyChain
from pycbc.waveform.bank import RatioFilterBank

logger = logging.getLogger(__name__)

tstart = time.time()


def get_args():
    parser = argparse.ArgumentParser(description=__doc__)
    pycbc.add_common_pycbc_options(parser)

    # --- Standard PyCBC Data/Segment Options ---
    pycbc.strain.insert_strain_option_group(parser)
    pycbc.strain.StrainSegments.insert_segment_option_group(parser)
    pycbc.psd.insert_psd_option_group(parser)
    pycbc.scheme.insert_processing_option_group(parser)
    pycbc.fft.insert_fft_option_group(parser)
    pycbc.inject.insert_injfilterrejector_option_group(parser)
    SignalConsistencyChain.insert_option_group(parser)

    # --- Analysis Options ---
    parser.add_argument("--output", required=True, help="Path to output HDF5 file.")

    parser.add_argument(
        "--bank-file", type=str, required=True, help="Path to the HDF5 Ratio Bank file."
    )

    parser.add_argument(
        "--snr-threshold",
        type=float,
        default=5.5,
        help="SNR threshold for trigger generation.",
    )
    parser.add_argument(
        "--newsnr-threshold",
        type=float,
        metavar="THRESHOLD",
        help="Cut triggers with NewSNR less than THRESHOLD",
    )
    parser.add_argument(
        "--low-frequency-cutoff",
        type=float,
        help="The low frequency cutoff to use for filtering (Hz)",
    )

    # --- Ratio Specific ---
    group = parser.add_argument_group("Ratio Filter Options")
    group.add_argument(
        "--high-frequency-cutoff",
        type=float,
        help="High frequency cutoff (defaults to Nyquist).",
    )
    group.add_argument(
        "--batch-size",
        type=int,
        default=64,
        help="Number of filters to process in one FFT batch.",
    )
    group.add_argument(
        "--fir-length",
        type=int,
        default=4096,
        help="Length in samples of the FFT block used for the"
        " FIR filter (and the ratio bank's frequency"
        " resolution).",
    )

    # Clustering
    parser.add_argument(
        "--cluster-window",
        type=float,
        default=0,
        help="Length of clustering window in seconds.",
    )

    parser.add_argument(
        "--keep-loudest-log-chirp-window",
        type=float,
        help="Keep loudest triggers within ln chirp mass window",
    )
    parser.add_argument(
        "--keep-loudest-interval",
        type=float,
        help="Window in seconds to maximize triggers over bank",
    )
    parser.add_argument(
        "--keep-loudest-num",
        type=int,
        help="Number of triggers to keep from each maximization interval",
    )
    parser.add_argument(
        "--keep-loudest-stat",
        default="newsnr",
        choices=pycbc.events.ranking.sngls_ranking_function_dict.keys(),
        help="Statistic used to determine loudest to keep",
    )

    return parser, parser.parse_args()


def main():
    parser, args = get_args()
    pycbc.init_logging(args.verbose)

    # --- 2. Verification ---
    pycbc.strain.verify_strain_options(args, parser)
    pycbc.strain.StrainSegments.verify_segment_options(args, parser)
    pycbc.psd.verify_psd_options(args, parser)
    pycbc.fft.verify_fft_options(args, parser)

    pycbc.fft.from_cli(args)

    with pycbc.scheme.from_cli(args):
        # --- 3. Data Generation ---
        inj_filter_rejector = pycbc.inject.InjFilterRejector.from_cli(args)
        gwstrain = pycbc.strain.from_cli(
            args,
            dyn_range_fac=pycbc.DYN_RANGE_FAC,
            inj_filter_rejector=inj_filter_rejector,
        )

        strain_segments = pycbc.strain.StrainSegments.from_cli(args, gwstrain)

        flen = strain_segments.freq_len
        delta_f = strain_segments.delta_f
        flow = args.low_frequency_cutoff

        # --- 4. Initialize Classes ---
        logger.info("Initializing Ratio Filter Bank...")
        bank = RatioFilterBank(
            args.bank_file,
            filter_length=flen,
            delta_f=delta_f,
            dtype=np.complex64,
        )
        bank.template_thinning(inj_filter_rejector)

        logger.info("Initializing Ratio Filter Engine...")
        engine = MatchedFilterRatioControl(
            snr_threshold=args.snr_threshold,
            delta_f=delta_f,
            high_frequency_cutoff=args.high_frequency_cutoff,
            fir_fft_length=args.fir_length,
            batch_size=args.batch_size,
            tap_sample_rate=bank.sample_rate,
            engine_sample_rate=args.sample_rate,
        )

        veto_chain = SignalConsistencyChain.from_cli(args, bank, args.sample_rate)

        # --- 5. Event Manager Setup ---
        out_types = {
            "time_index": int,
            "snr": complex64,
            "sigmasq": float32,
            "psd_var_val": float32,
            **veto_chain.columns,
        }

        out_vals_ref = dict.fromkeys(out_types)
        names = sorted(out_vals_ref.keys())

        # Pass strain gating info if available
        gating_info = getattr(gwstrain, "gating_info", None)

        event_mgr = pycbc.events.EventManager(
            args,
            names,
            [out_types[n] for n in names],
            psd=None,
            gating_info=gating_info,
        )

        cluster_window = int(args.cluster_window * gwstrain.sample_rate)

        # --- 6. Analysis Loop ---
        logger.info("Making frequency-domain data segments")
        segments = strain_segments.fourier_segments()

        pycbc.psd.associate_psds_to_segments(
            args,
            segments,
            gwstrain,
            flen,
            delta_f,
            flow,
            dyn_range_factor=pycbc.DYN_RANGE_FAC,
            precision="single",
        )

        # psd_var uses its own internal PSD estimation windows, independent
        # of the PSD each matched-filter segment (associated above) uses.
        if args.psdvar_segment is not None:
            logger.info("Calculating PSD variation")
            psd_var = pycbc.psd.calc_filt_psd_variation(
                gwstrain,
                args.psdvar_segment,
                args.psdvar_short_segment,
                args.psdvar_long_segment,
                args.psdvar_psd_duration,
                args.psdvar_psd_stride,
                args.psd_estimation,
                args.psdvar_low_freq,
                args.psdvar_high_freq,
            )

        n_coarse = len(bank.coarse_indices)

        seg_ids_local = []
        seg_t_idxs = []
        seg_snr_sqs = []
        seg_fine_mappings = []
        seg_h_norms = []
        seg_coarse_ids = []
        seg_vetoes = []

        tsetup = time.time() - tstart

        for i, coarse_idx in enumerate(bank.coarse_indices):
            ref_template = bank.get_coarse_template(coarse_idx)
            taps, counts, fine_indices, shifts = bank.get_firs(
                coarse_idx, return_shifts=True
            )
            filters_f, n_taps = engine.prepare_filters(taps, counts)
            logger.info(
                "  Ratio Batch %s/%s, %s FIR templates", i + 1, n_coarse, len(taps)
            )

            for s_num, stilde in enumerate(segments):
                logger.info("Processing Segment %s", s_num)
                t1 = time.time()

                ids_local, t_idxs, snrs, _, h_norm = engine.process_segment(
                    stilde,
                    stilde.psd,
                    ref_template,
                    filters_f,
                    n_taps,
                    np.arange(len(fine_indices)),
                    valid_slice=stilde.analyze,
                    templates=bank.table[fine_indices],
                )

                if len(ids_local) > 0:
                    t_offset = -stilde.analyze.start + stilde.cumulative_index
                    columns = {}
                    if args.psdvar_segment is not None:
                        columns["psd_var_val"] = pycbc.psd.find_trigger_value(
                            psd_var,
                            t_idxs + t_offset,
                            args.gps_start_time,
                            args.sample_rate,
                        )

                    keep, vetoes = veto_chain.values(
                        snrs,
                        t_idxs - shifts[ids_local],
                        fine_indices[ids_local],
                        engine.fine_template,
                        engine.fine_correlation,
                        stilde=stilde,
                        columns=columns,
                    )
                    ids_local, t_idxs, snrs = (
                        ids_local[keep],
                        t_idxs[keep],
                        snrs[keep],
                    )
                    vetoes = {k: v[keep] for k, v in vetoes.items()}

                    t_idxs += t_offset - shifts[ids_local]
                    seg_ids_local.append(ids_local)
                    seg_t_idxs.append(t_idxs)
                    seg_snr_sqs.append(snrs)
                    seg_fine_mappings.append(fine_indices)
                    seg_h_norms.append(h_norm)
                    seg_coarse_ids.append(coarse_idx)
                    seg_vetoes.append(vetoes)

                t2 = time.time()
                tperf = (
                    (stilde.analyze.stop - stilde.analyze.start)
                    * stilde.delta_t
                    / (t2 - t1)
                    * len(taps)
                )
                logger.info("batch perf: %s templates s/s", tperf)

        logger.info("Grouping triggers...")

        triggers_by_template = {}
        for k in range(len(seg_ids_local)):
            ids = seg_ids_local[k]
            times = seg_t_idxs[k]
            snrs = seg_snr_sqs[k]
            coarse_id = seg_coarse_ids[k]
            norms = seg_h_norms[k]
            mapping = seg_fine_mappings[k]
            vetoes = seg_vetoes[k]

            for j in range(len(ids)):
                local_idx = ids[j]
                global_idx = mapping[local_idx]

                if global_idx not in triggers_by_template:
                    triggers_by_template[global_idx] = ([], [], [], [], {})

                triggers_by_template[global_idx][0].append(snrs[j])
                triggers_by_template[global_idx][1].append(times[j])
                triggers_by_template[global_idx][2].append(norms)
                triggers_by_template[global_idx][3].append(coarse_id)
                for col, val in vetoes.items():
                    triggers_by_template[global_idx][4].setdefault(col, []).append(
                        val[j]
                    )

        # C. Store
        for global_id, (
            snr,
            time_list,
            norm,
            _coarse_id,
            vetoes,
        ) in triggers_by_template.items():
            out_vals = out_vals_ref.copy()
            out_vals["time_index"] = np.array(time_list)

            sigmasq_rescale = bank.sigma_rescale(global_id) ** 2.0

            out_vals["snr"] = np.array(snr)
            out_vals["sigmasq"] = np.ones(len(time_list)) * norm * sigmasq_rescale
            for col, val in vetoes.items():
                out_vals[col] = np.array(val)

            if args.psdvar_short_segment is not None:
                out_vals["psd_var_val"] = pycbc.psd.find_trigger_value(
                    psd_var,
                    out_vals["time_index"],
                    args.gps_start_time,
                    args.sample_rate,
                )

            event_mgr.new_template(tmplt=bank.table[global_id])
            event_mgr.add_template_events(names, [out_vals[n] for n in names])

            if cluster_window > 0:
                event_mgr.cluster_template_events("time_index", "snr", cluster_window)

            event_mgr.finalize_template_events()

    # --- 7. Finalize ---
    tstop = time.time()
    run_time = tstop - tstart
    event_mgr.save_performance(1, len(segments), len(bank), run_time, tsetup)

    logger.info("Consolidating and writing events...")
    event_mgr.consolidate_events(args, gwstrain=gwstrain)
    event_mgr.finalize_events()
    event_mgr.write_events(args.output)

    logger.info("Finished.")


if __name__ == "__main__":
    main()
