# Robustness options applied to wget in PyCBC's CI.  The workflows point wget
# at this file by exporting WGETRC=<repo>/tools/.wgetrc; scripts run directly
# on a workstation do not set WGETRC and so keep wget's defaults (no retries).
# Keep behavioural flags (-nv, -nc, -O, ...) at the call sites; only the retry
# hardening lives here.
tries = 5
waitretry = 5
timeout = 30
retry_connrefused = on
retry_on_http_error = 429,500,502,503,504
