# Robustness options applied to curl in PyCBC's CI.  The workflows point curl
# at this file by exporting CURL_HOME=<repo>/tools; scripts run directly on a
# workstation do not set CURL_HOME and so keep curl's defaults (no retries).
# Keep behavioural flags (-O, -L, --silent, ...) at the call sites; only the
# retry / fail-fast hardening lives here.
retry = 5
retry-delay = 2
retry-all-errors
fail
